#!/usr/bin/env python3
"""
Validate a task dossier (01-brief-and-context.md) against the Prep template.

Checks:
  * a real task name in the H1 heading
  * the Source/Status metadata line (Status must be Pending, Context Pending or Completed)
  * every required section/subsection exists and has real content
    (template placeholders like "<Item>" or "- <Constraint>" do not count)
  * the Decision Log: counts questions and flags malformed, duplicate or gapped entries

Prints a JSON report on stdout.
Exit codes: 0 = valid, 1 = validation errors, 2 = file could not be read.

Usage:
  python check_dossier.py path/to/01-brief-and-context.md
  cat dossier.md | python check_dossier.py -
"""

import argparse
import json
import re
import sys

# Required structure: H2 section -> list of H3 subsections (empty list = H2 holds content itself)
TEMPLATE = {
    "1. Task Brief": [
        "Problem Statement",
        "Expected Outcome",
        "Acceptance Criteria",
        "Out of Scope",
    ],
    "2. Context": [
        "Codebase",
        "Conventions & Prior Art",
        "Related Work",
        "External References",
        "Constraints",
    ],
    "3. Decision Log": [],
}

VALID_STATUSES = {"Pending", "Context Pending", "Completed"}

H1_RE = re.compile(r"^#\s+(.*?)\s*#*\s*$")
H2_RE = re.compile(r"^##\s+(.*?)\s*#*\s*$")
H3_RE = re.compile(r"^###\s+(.*?)\s*#*\s*$")
FENCE_RE = re.compile(r"^\s*(```|~~~)")
META_RE = re.compile(
    r"^Source:\s*(?P<source>.*?)\s*·\s*Status:\s*(?P<status>.*?)\s*$")
# A line whose only text is a template placeholder, optionally behind a list marker
PLACEHOLDER_RE = re.compile(r"^\s*(?:[-*+]|\d+[.)])?\s*<[^<>]*>\s*$")
# Same, but for list items of the form "<thing> — <why>"
PLACEHOLDER_PAIR_RE = re.compile(
    r"^\s*(?:[-*+]|\d+[.)])?\s*`?<[^<>]*>`?\s*[—–-]\s*<[^<>]*>\s*$")
# The untouched Decision Log template entry
PLACEHOLDER_QUESTION_RE = re.compile(
    r"^\s*[-*+]\s*\*\*Q\d+\*\*\s*[—–-]\s*<[^<>]*>\s*:\s*<[^<>]*>\s*$")
QUESTION_RE = re.compile(
    r"^\s*[-*+]\s*\*\*Q(?P<num>\d+)\*\*\s*[—–-]\s*(?P<title>.+?)\s*:\s*(?P<decision>.*\S)?\s*$"
)
QUESTION_LOOSE_RE = re.compile(r"^\s*[-*+]?\s*\**Q\d+\b")
HTML_COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)


def normalize(title: str) -> str:
    return re.sub(r"\s+", " ", title).strip().lower()


def is_placeholder(line: str) -> bool:
    return bool(
        PLACEHOLDER_RE.match(line)
        or PLACEHOLDER_PAIR_RE.match(line)
        or PLACEHOLDER_QUESTION_RE.match(line)
    )


def meaningful_lines(lines):
    """Lines that count as real content (non-blank, not a template placeholder)."""
    return [l for l in lines if l.strip() and not is_placeholder(l)]


def parse(text: str):
    """Split the document into H1, preamble and a tree of H2/H3 blocks with line numbers."""
    text = HTML_COMMENT_RE.sub(lambda m: "\n" * m.group(0).count("\n"), text)
    lines = text.splitlines()

    doc = {"h1": None, "h1_line": None, "preamble": [], "h2": []}
    current_h2 = None
    current_h3 = None
    in_fence = False

    for idx, raw in enumerate(lines, start=1):
        line = raw.rstrip()

        if FENCE_RE.match(line):
            in_fence = not in_fence
        heading_allowed = not in_fence

        m3 = H3_RE.match(line) if heading_allowed else None
        m2 = H2_RE.match(line) if heading_allowed and not m3 else None
        m1 = H1_RE.match(line) if heading_allowed and not (m2 or m3) else None

        if m1 and doc["h1"] is None and current_h2 is None:
            doc["h1"], doc["h1_line"] = m1.group(1), idx
        elif m2:
            current_h2 = {"title": m2.group(
                1), "line": idx, "body": [], "h3": []}
            current_h3 = None
            doc["h2"].append(current_h2)
        elif m3 and current_h2 is not None:
            current_h3 = {"title": m3.group(1), "line": idx, "body": []}
            current_h2["h3"].append(current_h3)
        elif current_h3 is not None:
            current_h3["body"].append(line)
        elif current_h2 is not None:
            current_h2["body"].append(line)
        else:
            doc["preamble"].append((idx, line))

    return doc


def check_decision_log(body, errors, warnings):
    questions, malformed = [], []
    for line in body:
        if not line.strip() or is_placeholder(line):
            continue
        m = QUESTION_RE.match(line)
        if m:
            q = {
                "number": int(m.group("num")),
                "title": m.group("title").strip(),
                "decision": (m.group("decision") or "").strip(),
            }
            if not q["decision"] or is_placeholder(q["decision"]):
                errors.append(f"Decision Log: Q{q['number']} has no decision.")
            questions.append(q)
        elif QUESTION_LOOSE_RE.match(line):
            malformed.append(line.strip())

    for entry in malformed:
        errors.append(
            f"Decision Log: malformed entry (expected '- **Qn** — <title>: <decision>'): {entry}")

    numbers = [q["number"] for q in questions]
    dupes = sorted({n for n in numbers if numbers.count(n) > 1})
    if dupes:
        errors.append(f"Decision Log: duplicate question numbers: {
                      ', '.join(f'Q{n}' for n in dupes)}.")
    if numbers:
        expected = set(range(1, max(numbers) + 1))
        missing = sorted(expected - set(numbers))
        if missing:
            warnings.append(f"Decision Log: numbering gaps, missing {
                            ', '.join(f'Q{n}' for n in missing)}.")
        if numbers != sorted(numbers):
            warnings.append(
                "Decision Log: questions are not in ascending order.")

    return {
        "question_count": len(questions),
        "questions": questions,
        "malformed_entries": malformed,
    }


def validate(text: str, source_name: str):
    errors, warnings = [], []
    doc = parse(text)

    # --- Task name -------------------------------------------------------
    task_name = doc["h1"]
    if task_name is None:
        errors.append(
            "Missing task name: no '# <task_name>' heading found before the first section.")
    elif not task_name.strip() or is_placeholder(task_name) or task_name.strip() == "<task_name>":
        errors.append("Task name is empty or still the template placeholder.")
        task_name = None

    # --- Metadata line ---------------------------------------------------
    metadata = {"source": None, "status": None}
    meta_lines = [(n, l) for n, l in doc["preamble"] if l.strip()
                  and (doc["h1_line"] is None or n > doc["h1_line"])]
    meta_match = next((META_RE.match(l.strip())
                      for _, l in meta_lines if META_RE.match(l.strip())), None)
    if not meta_match:
        errors.append(
            "Missing metadata line: 'Source: <...> · Status: <...>'.")
    else:
        metadata["source"] = meta_match.group("source") or None
        metadata["status"] = meta_match.group("status") or None
        if not metadata["source"] or is_placeholder(metadata["source"]):
            errors.append("Metadata: Source is empty or still a placeholder.")
        if metadata["status"] not in VALID_STATUSES:
            errors.append(
                f"Metadata: invalid Status {metadata['status']!r}; expected one of {
                    sorted(VALID_STATUSES)}."
            )

    # --- Sections --------------------------------------------------------
    h2_index = {}
    for h2 in doc["h2"]:
        h2_index.setdefault(normalize(h2["title"]), h2)

    sections_report = {}
    decision_log = {"question_count": 0,
                    "questions": [], "malformed_entries": []}

    for h2_title, h3_titles in TEMPLATE.items():
        h2 = h2_index.get(normalize(h2_title))
        entry = {"present": h2 is not None, "line": h2["line"] if h2 else None}

        if h2 is None:
            errors.append(f"Missing section: '## {h2_title}'.")

        if h3_titles:
            entry["subsections"] = {}
            h3_index = {}
            if h2:
                for h3 in h2["h3"]:
                    h3_index.setdefault(normalize(h3["title"]), h3)
            for h3_title in h3_titles:
                h3 = h3_index.get(normalize(h3_title))
                has_content = bool(h3 and meaningful_lines(h3["body"]))
                entry["subsections"][h3_title] = {
                    "present": h3 is not None,
                    "has_content": has_content,
                    "line": h3["line"] if h3 else None,
                }
                if h2 is not None and h3 is None:
                    errors.append(f"Missing subsection: '### {
                                  h3_title}' under '## {h2_title}'.")
                elif h3 is not None and not has_content:
                    errors.append(f"Empty subsection: '### {
                                  h3_title}' has no content (or only placeholders).")
            entry["has_content"] = all(s["has_content"]
                                       for s in entry["subsections"].values())
            if h2:
                known = {normalize(t) for t in h3_titles}
                for h3 in h2["h3"]:
                    if normalize(h3["title"]) not in known:
                        warnings.append(f"Unexpected subsection '### {h3['title']}' under '## {
                                        h2_title}' (line {h3['line']}).")
        else:
            body = h2["body"] if h2 else []
            entry["has_content"] = bool(meaningful_lines(body))
            if h2 is not None and not entry["has_content"]:
                errors.append(f"Empty section: '## {
                              h2_title}' has no content (or only placeholders).")
            if normalize(h2_title) == normalize("3. Decision Log") and h2 is not None:
                decision_log = check_decision_log(body, errors, warnings)

        sections_report[h2_title] = entry

    known_h2 = {normalize(t) for t in TEMPLATE}
    for h2 in doc["h2"]:
        if normalize(h2["title"]) not in known_h2:
            warnings.append(f"Unexpected section '## {
                            h2['title']}' (line {h2['line']}).")

    return {
        "file": source_name,
        "valid": not errors,
        "task_name": task_name,
        "metadata": metadata,
        "sections": sections_report,
        "decision_log": decision_log,
        "errors": errors,
        "warnings": warnings,
    }


def main():
    parser = argparse.ArgumentParser(
        description="Validate a task dossier and print a JSON report.")
    parser.add_argument(
        "path", help="Path to the dossier markdown file, or '-' for stdin.")
    parser.add_argument("--compact", action="store_true",
                        help="Print JSON on a single line.")
    args = parser.parse_args()

    try:
        if args.path == "-":
            text, name = sys.stdin.read(), "<stdin>"
        else:
            with open(args.path, encoding="utf-8") as fh:
                text, name = fh.read(), args.path
    except OSError as exc:
        json.dump({"file": args.path, "valid": False, "errors": [
                  f"Cannot read file: {exc}"]}, sys.stdout)
        sys.stdout.write("\n")
        sys.exit(2)

    report = validate(text, name)
    json.dump(report, sys.stdout, ensure_ascii=False,
              indent=None if args.compact else 2)
    sys.stdout.write("\n")
    sys.exit(0 if report["valid"] else 1)


if __name__ == "__main__":
    main()
